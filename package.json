{
  "name": "permits-gcs",
  "version": "2.0.0",
  "private": true,
  "description": "Permit & Parcel MCP (permits-GCs) — PermitStack commercial GCs, request estimates, calling lists, DCAD/TAD/CCAD parcels",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshuaosborn561-lang/permits-GCs.git"
  },
  "homepage": "https://github.com/joshuaosborn561-lang/permits-GCs",
  "type": "module",
  "bin": {
    "permit-parcel-mcp": "./dist/mcp/stdio.js",
    "permits-gcs-mcp": "./dist/mcp/stdio.js"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "mcp": "tsx src/mcp/stdio.ts",
    "mcp:stdio": "node dist/mcp/stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/server/lib/texasComptroller.test.ts src/server/lib/floridaSunbiz.test.ts src/server/lib/floridaSosKey.test.ts src/server/lib/contactScore.test.ts src/server/lib/permitstack.test.ts src/server/services/importCallingList.test.ts src/server/services/shovelsGeoTargets.test.ts src/server/services/shovelsPull.test.ts src/server/services/pullShovelsCallingList.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
